      { "id": "4", "input": "50 40 30 20 10", "expectedOutput": "50" },
      { "id": "5", "input": "100 200 300", "expectedOutput": "300" },
      { "id": "6", "input": "-5 -10 -3", "expectedOutput": "-3" },
      { "id": "7", "input": "0 -1 1", "expectedOutput": "1" },
      { "id": "8", "input": "999 1 500 250", "expectedOutput": "999" },
      { "id": "9", "input": "5 5 5 5", "expectedOutput": "5" },
      { "id": "10", "input": "123 456 789 111", "expectedOutput": "789" }
