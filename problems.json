  "hard_array_sorting": {
    "title": "เรียงลำดับอาร์เรย์",
    "description": "โปรแกรมรับตัวเลขหลายจำนวนคั่นด้วยช่องว่าง แล้วเรียงลำดับจากน้อยไปมาก แสดงผลแบบเลขคั่นด้วยช่องว่าง",
    "difficulty": "hard",
    "concept": "Array",
    "testCases": [
      { "id": "1", "input": "5 2 8 1 9", "expectedOutput": "1 2 5 8 9" },
      { "id": "2", "input": "3 3 3", "expectedOutput": "3 3 3" },
      { "id": "3", "input": "1", "expectedOutput": "1" },
      { "id": "4", "input": "4 3 2 1", "expectedOutput": "1 2 3 4" },
      { "id": "5", "input": "100 50 75 25", "expectedOutput": "25 50 75 100" },
      { "id": "6", "input": "9 8 7 6 5 4 3 2 1", "expectedOutput": "1 2 3 4 5 6 7 8 9" },
      { "id": "7", "input": "50 30 40 20 10", "expectedOutput": "10 20 30 40 50" },
      { "id": "8", "input": "7 7 7 7", "expectedOutput": "7 7 7 7" },
      { "id": "9", "input": "5 3 9 1 7", "expectedOutput": "1 3 5 7 9" },
      { "id": "10", "input": "10 5 15 20 25", "expectedOutput": "5 10 15 20 25" }
    ]
  },

  "hard_matrix_multiply": {
    "title": "คูณเมทริกซ์ 2x2",
    "description": "โปรแกรมรับตัวเลขแปดจำนวน (แทนเมทริกซ์ A 2x2 และ B 2x2) แล้วหาผลคูณ A*B แสดงผล 4 ตัวเลขเรียงลำดับ",
    "difficulty": "hard",
    "concept": "Logic",
    "testCases": [
      { "id": "1", "input": "1 2 3 4 5 6 7 8", "expectedOutput": "19 22 43 50" },
      { "id": "2", "input": "1 0 0 1 2 3 4 5", "expectedOutput": "2 3 4 5" },
      { "id": "3", "input": "2 0 0 2 1 1 1 1", "expectedOutput": "2 2 2 2" },
      { "id": "4", "input": "1 1 1 1 1 1 1 1", "expectedOutput": "2 2 2 2" },
      { "id": "5", "input": "0 0 0 0 1 2 3 4", "expectedOutput": "0 0 0 0" },
      { "id": "6", "input": "2 1 3 4 1 0 2 3", "expectedOutput": "4 3 11 12" },
      { "id": "7", "input": "5 0 0 5 2 3 4 1", "expectedOutput": "10 15 20 5" },
      { "id": "8", "input": "1 2 0 1 3 2 1 4", "expectedOutput": "5 10 1 4" },
      { "id": "9", "input": "3 2 1 4 2 0 1 3", "expectedOutput": "8 6 6 12" },
      { "id": "10", "input": "4 1 2 3 1 2 3 1", "expectedOutput": "7 9 11 9" }
    ]
  },

