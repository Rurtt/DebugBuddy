  "easy_even_odd": {
    "title": "ตรวจสอบเลขคู่เลขคี่",
    "description": "โปรแกรมรับตัวเลขหนึ่งจำนวน แล้วบอกว่าเป็นเลขคู่หรือเลขคี่ (ตอบ even หรือ odd)",
    "difficulty": "easy",
    "concept": "Conditional",
    "testCases": [
      { "id": "1", "input": "4", "expectedOutput": "even" },
      { "id": "2", "input": "5", "expectedOutput": "odd" },
      { "id": "3", "input": "100", "expectedOutput": "even" },
      { "id": "4", "input": "1", "expectedOutput": "odd" },
      { "id": "5", "input": "0", "expectedOutput": "even" },
      { "id": "6", "input": "999", "expectedOutput": "odd" },
      { "id": "7", "input": "1000", "expectedOutput": "even" },
      { "id": "8", "input": "-2", "expectedOutput": "even" },
      { "id": "9", "input": "-3", "expectedOutput": "odd" },
      { "id": "10", "input": "777", "expectedOutput": "odd" }
    ]
  },

  "easy_string_reverse": {
    "title": "กลับลำดับข้อความ",
    "description": "โปรแกรมรับข้อความหนึ่งบรรทัด แล้วแสดงข้อความนั้นในลำดับที่กลับหัวกลับหาง",
    "difficulty": "easy",
    "concept": "Strings",
    "testCases": [
      { "id": "1", "input": "hello", "expectedOutput": "olleh" },
      { "id": "2", "input": "debugbuddy", "expectedOutput": "yddubgued" },
      { "id": "3", "input": "a", "expectedOutput": "a" },
      { "id": "4", "input": "ab", "expectedOutput": "ba" },
      { "id": "5", "input": "abc", "expectedOutput": "cba" },
      { "id": "6", "input": "racecar", "expectedOutput": "racecar" },
      { "id": "7", "input": "12345", "expectedOutput": "54321" },
      { "id": "8", "input": "code", "expectedOutput": "edoc" },
      { "id": "9", "input": "test", "expectedOutput": "tset" },
      { "id": "10", "input": "world", "expectedOutput": "dlrow" }
    ]
  },

  "easy_sum_1_to_n": {
    "title": "บวกตัวเลขตั้งแต่ 1 ถึง n",
