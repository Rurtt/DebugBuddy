{
  "easy_sum_two_numbers": {
    "title": "บวกตัวเลขสองจำนวน",
    "description": "โปรแกรมรับตัวเลขสองจำนวน แล้วบวกกันและแสดงผลลัพธ์",
    "difficulty": "easy",
    "concept": "Arithmetic",
    "testCases": [
      { "id": "1", "input": "2 3", "expectedOutput": "5" },
      { "id": "2", "input": "10 20", "expectedOutput": "30" },
      { "id": "3", "input": "5 5", "expectedOutput": "10" },
      { "id": "4", "input": "0 0", "expectedOutput": "0" },
      { "id": "5", "input": "100 200", "expectedOutput": "300" },
      { "id": "6", "input": "-5 10", "expectedOutput": "5" },
      { "id": "7", "input": "-10 -20", "expectedOutput": "-30" },
      { "id": "8", "input": "999 1", "expectedOutput": "1000" },
      { "id": "9", "input": "1 1", "expectedOutput": "2" },
      { "id": "10", "input": "42 58", "expectedOutput": "100" }
    ]
  },

  "easy_find_minimum": {
    "title": "หาตัวเลขที่น้อยที่สุด",
    "description": "โปรแกรมรับตัวเลขหลายจำนวนคั่นด้วยช่องว่าง แล้วหาค่าที่น้อยที่สุด",
    "difficulty": "easy",
    "concept": "Loops",
    "testCases": [
      { "id": "1", "input": "3 1 4 1 5", "expectedOutput": "1" },
      { "id": "2", "input": "10", "expectedOutput": "10" },
      { "id": "3", "input": "9 8 7 6 5", "expectedOutput": "5" },
      { "id": "4", "input": "50 40 30 20 10", "expectedOutput": "10" },
      { "id": "5", "input": "100 200 300", "expectedOutput": "100" },
      { "id": "6", "input": "-5 -10 -3", "expectedOutput": "-10" },
      { "id": "7", "input": "0 -1 1", "expectedOutput": "-1" },
      { "id": "8", "input": "999 1 500 250", "expectedOutput": "1" },
      { "id": "9", "input": "5 5 5 5", "expectedOutput": "5" },
      { "id": "10", "input": "123 456 789 111", "expectedOutput": "111" }
    ]
  },

  "easy_find_maximum": {
    "title": "หาตัวเลขที่มากที่สุด",
    "description": "โปรแกรมรับตัวเลขหลายจำนวนคั่นด้วยช่องว่าง แล้วหาค่าที่มากที่สุด",
