{
  "name": "debugbuddy-backend",
  "version": "1.0.0",
  "description": "AI-powered C++ learning platform for Thai students",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/services/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "education",
    "programming",
    "ai",
    "mentoring",
    "c++",
    "thai"
  ],
  "author": "DebugBuddy Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.12.0",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.1.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
